# Maintainer: Braxton Culver <braxton@braxtonculver.com>
# yutashell — Quickshell config for Hyprland (pure QML, no compiled parts)
#
# Install target is /usr/share/yutashell; users copy or symlink it:
#   cp -r /usr/share/yutashell ~/.config/quickshell/yuta-qs
# and autostart `qs -c yuta-qs` from Hyprland.

pkgname=yutashell-git
pkgver=1.5.0
pkgrel=1
pkgdesc="Quickshell desktop shell config for Hyprland — 90 matugen templates, 21 bar segments, 39 IPC targets"
arch=(any)
url="https://github.com/braxtonculver/yuta-qs"
license=(GPL-3.0-only)
depends=(
    quickshell
    hyprland
    matugen
    grim
    slurp
    curl
    wl-clipboard
    cliphist
    awww
    jq
    pipewire
    networkmanager
    bluez
    ttf-jetbrains-mono-nerd
)
optdepends=(
    'cava: audio visualizer in the bar'
    'hyprsunset: night light (wayland)'
    'hyprpicker: color picker'
    'ddcutil: external monitor brightness (DDC/CI)'
    'powerprofilesctl: power profile switching'
    'gpu-screen-recorder: screen recording widget'
    'noto-fonts-cjk: Japanese labels (romaji fallback otherwise)'
)
makedepends=(git)
provides=(yutashell)
conflicts=(yutashell)
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd yuta-qs
    printf "1.5.0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    cd yuta-qs
    install -dm755 "$pkgdir/usr/share/yutashell"
    cp -r --no-preserve=ownership . "$pkgdir/usr/share/yutashell/"
    rm -rf "$pkgdir/usr/share/yutashell/.git" \
           "$pkgdir/usr/share/yutashell/dist" \
           "$pkgdir/usr/share/yutashell/REFERENCEREADONLY"
}
